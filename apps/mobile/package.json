{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check-types": "tsc --noEmit",
    "lint": "expo lint",
    "assets": "node scripts/make-sounds.mjs && node scripts/make-icons.mjs",
    "build:android": "npx -y eas-cli@latest build -p android --profile ${PROFILE:-production} --local --non-interactive --output ./build/tafelrush.aab",
    "build:ios": "npx -y eas-cli@latest build -p ios --profile ${PROFILE:-production} --local --non-interactive --output ./build/tafelrush.ipa",
    "submit:android": "npx -y eas-cli@latest submit -p android --profile production --non-interactive --path ./build/tafelrush.aab",
    "submit:ios": "npx -y eas-cli@latest submit -p ios --profile production --non-interactive --path ./build/tafelrush.ipa",
    "release:android": "pnpm build:android && pnpm submit:android",
    "release:ios": "pnpm build:ios && pnpm submit:ios"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@tafelrush/shared": "workspace:*",
    "expo": "~57.0.28",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.56.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
