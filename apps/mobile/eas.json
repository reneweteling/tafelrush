{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.13.1",
      "pnpm": "10.30.1",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./build/secrets/play-service-account.json"
      },
      "ios": {
        "appleTeamId": "ND82KXRD2Q",
        "ascAppId": "6822244770",
        "ascApiKeyPath": "./build/secrets/asc-api-key.p8",
        "ascApiKeyIssuerId": "f7c12ebb-574f-4e77-b03d-bc6b1f0d390c",
        "ascApiKeyId": "DSKW796U8W"
      }
    }
  }
}
