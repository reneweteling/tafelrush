# Generated by `make env-example`: every environment file with the values left out.
# The values live in Bitwarden (item "tafelrush"). `make env ENV=<env>` pulls them.

# ==== local: .env
# Local machine: builds and store submits. Files are base64, see apps/mobile/scripts/secret-files.mjs.

# iOS distribution certificate (.p12, base64) and its password
APPLE_DIST_CERT_P12=
APPLE_DIST_CERT_PASSWORD=
# iOS App Store provisioning profile (.mobileprovision, base64)
IOS_PROVISIONING_PROFILE=

# App Store Connect API key: id, issuer and the .p8 (base64)
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_P8=

# Google Play service account for uploads (.json, base64)
PLAY_SERVICE_ACCOUNT_JSON=

# ==== production: .env.production
# Web app on Dokku (tafelrush.nl). Push with: make dokku-env
# SHA-256 of the Play app signing certificate, for /.well-known/assetlinks.json
ANDROID_CERT_SHA256=
