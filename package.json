{
  "name": "tafel-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Tafel Rush: tafels oefenen door ze hardop te zeggen. App plus website tafelrush.nl.",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "typecheck": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "vitest run",
    "mobile": "pnpm --filter mobile start",
    "release:ios": "pnpm --filter mobile release:ios",
    "release:android": "pnpm --filter mobile release:android",
    "release": "pnpm --filter mobile release:android && pnpm --filter mobile release:ios"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.1"
}
